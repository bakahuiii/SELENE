<Window x:Class="Selene.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SELENE Windows 0.5.2"
        Width="720"
        MinWidth="640"
        Height="920"
        MinHeight="620"
        WindowStartupLocation="CenterScreen">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="28">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="16" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="16" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="16" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="16" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="SELENE" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
          <Border Margin="10,5,0,0" Padding="7,2" Background="#E8EFF8" CornerRadius="4">
            <TextBlock x:Name="VersionText" Foreground="#2E5B91" FontSize="12" />
          </Border>
        </StackPanel>
        <TextBlock Margin="0,7,0,0" TextWrapping="Wrap" Foreground="#485465"
                   Text="Windows 本地时间线采集器。选择需要的数据范围后，它会写入 THEIA 可直接导入的不可变快照。" />
      </StackPanel>

      <Border Grid.Row="2" Padding="18" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6">
        <StackPanel>
          <TextBlock Text="导出目录" FontWeight="SemiBold" FontSize="16" />
          <TextBlock Margin="0,5,0,10" Foreground="#667085" TextWrapping="Wrap"
                     Text="每次采集会新建一个 SELENE-v1-时间戳 文件夹。不会覆盖、合并或修改已有快照。" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="OutputDirectoryBox" IsReadOnly="True" VerticalContentAlignment="Center" Padding="8,5" />
            <Button Grid.Column="1" Content="选择文件夹" Click="ChooseDirectory_Click" />
          </Grid>
        </StackPanel>
      </Border>

      <Border Grid.Row="4" Padding="18" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6">
        <StackPanel>
          <TextBlock Text="自动采集" FontWeight="SemiBold" FontSize="16" />
          <CheckBox x:Name="AutomaticCollectionBox" Content="在 SELENE 运行期间自动采集" Checked="SettingsChanged" Unchecked="SettingsChanged" />
          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="150" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="采集间隔" />
            <ComboBox x:Name="IntervalBox" Grid.Column="1" Margin="12,0,0,0" SelectionChanged="SettingsChanged">
              <ComboBoxItem Content="5 分钟" Tag="5" />
              <ComboBoxItem Content="15 分钟" Tag="15" />
              <ComboBoxItem Content="30 分钟" Tag="30" />
              <ComboBoxItem Content="60 分钟" Tag="60" />
            </ComboBox>
          </Grid>
          <CheckBox x:Name="StartupBox" Content="登录 Windows 后启动 SELENE" Checked="SettingsChanged" Unchecked="SettingsChanged" />
          <TextBlock Margin="0,8,0,0" Foreground="#667085" TextWrapping="Wrap"
                     Text="应用关闭窗口后会继续驻留在系统托盘。任务栏右下角的 SELENE 图标可显示、立即采集或退出。" />
        </StackPanel>
      </Border>

      <Border Grid.Row="6" Padding="18" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6">
        <StackPanel>
          <TextBlock Text="Android 一次配对同步" FontWeight="SemiBold" FontSize="16" />
          <TextBlock Margin="0,5,0,10" Foreground="#667085" TextWrapping="Wrap"
                     Text="生成一次性二维码后，用 SELENE Android 扫描。首次配对需在同一局域网；成功后会通过 Syncthing 自动跨网络同步，不需要再次扫码。" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SyncInboxDirectoryBox" IsReadOnly="True" VerticalContentAlignment="Center" Padding="8,5" />
            <Button Grid.Column="1" Content="选择收件箱" Click="ChooseSyncInbox_Click" />
          </Grid>
          <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="BeginPairingButton" Content="生成一次性配对二维码" Click="BeginPairing_Click" />
            <Button x:Name="CopyPairingCodeButton" Content="复制配对码" Click="CopyPairingCode_Click" IsEnabled="False" />
          </StackPanel>
          <Image x:Name="PairingQrImage" Width="360" Height="360" Margin="0,10,0,0" Stretch="Uniform" Visibility="Collapsed" />
          <TextBox x:Name="PairingCodeBox" Margin="0,8,0,0" MaxHeight="90" IsReadOnly="True"
                   AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" />
          <TextBlock x:Name="PairingStatusText" Margin="0,8,0,0" Foreground="#344054" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Grid.Row="8" Padding="18" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6">
        <StackPanel>
          <TextBlock Text="采集范围与隐私边界" FontWeight="SemiBold" FontSize="16" />
          <TextBlock Margin="0,5,0,4" Foreground="#667085" TextWrapping="Wrap"
                     Text="只有已勾选的字段会写入后续快照。关闭选项后，待导出的旧会话会在写入前删除相应字段。" />
          <CheckBox x:Name="ForegroundApplicationsBox" Content="前台应用和使用时段" Checked="SettingsChanged" Unchecked="SettingsChanged" />
          <CheckBox x:Name="WindowTitlesBox" Margin="22,7,0,0" Content="窗口标题（可能含文档、聊天或网页标题）" Checked="SettingsChanged" Unchecked="SettingsChanged" />
          <CheckBox x:Name="ExecutablePathsBox" Margin="22,7,0,0" Content="可执行文件完整路径" Checked="SettingsChanged" Unchecked="SettingsChanged" />
          <CheckBox x:Name="BrowserUrlsBox" Margin="22,7,0,0" Content="浏览器当前页面 URL（尽力采集，可能含查询参数）" Checked="SettingsChanged" Unchecked="SettingsChanged" />
          <CheckBox x:Name="DeviceStateBox" Content="设备状态（空闲时长、电量、充电）" Checked="SettingsChanged" Unchecked="SettingsChanged" />
          <CheckBox x:Name="NetworkStateBox" Content="网络连接状态和传输类型" Checked="SettingsChanged" Unchecked="SettingsChanged" />
          <Border Margin="0,12,0,0" Padding="12" Background="#FFF9E8" BorderBrush="#E9D39A" BorderThickness="1" CornerRadius="5">
            <TextBlock TextWrapping="Wrap" Foreground="#665117"
                       Text="敏感数据提示：窗口标题、路径和 URL 会写入本地快照，并在导入 THEIA 后可能成为分析上下文。URL 只尝试读取当前前台浏览器的地址栏，不读取网页正文、表单、键盘、剪贴板、通知、聊天数据库、短信、通话、截图或支付记录。浏览器安全策略、隐身窗口、辅助功能权限和应用更新都可能导致 URL 缺失。" />
          </Border>
        </StackPanel>
      </Border>

      <StackPanel Grid.Row="9" Margin="0,18,0,0">
        <StackPanel Orientation="Horizontal">
          <Button x:Name="CaptureButton" Content="立即采集" Click="CaptureNow_Click" />
          <Button Content="退出 SELENE" Click="Exit_Click" />
        </StackPanel>
        <TextBlock x:Name="StatusText" Margin="0,12,0,0" Foreground="#344054" TextWrapping="Wrap" />
      </StackPanel>
    </Grid>
  </ScrollViewer>
</Window>
